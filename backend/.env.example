# ==========================================
# Neon PostgreSQL Database Connection
# ==========================================
# Get your connection string from https://console.neon.tech
# Example: postgresql://neondb_owner:npg_password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# ==========================================
# Aiven Kafka Connection Details
# ==========================================
# Get service URI from https://console.aiven.io
# Example: kafka-service-myorg.aivencloud.com:12345
KAFKA_BOOTSTRAP_SERVERS=kafka-service-myorg.aivencloud.com:12345
KAFKA_TOPIC=fintech.transactions
KAFKA_CONSUMER_GROUP=fraud-detection-group

# Kafka Security Protocol: SSL, SASL_SSL, or PLAINTEXT
KAFKA_SECURITY_PROTOCOL=SSL

# If using SSL certificate files (Standard Aiven Kafka Auth):
# Place ca.pem, service.cert, and service.key in backend/certs/ or specify paths
KAFKA_SSL_CAFILE=certs/ca.pem
KAFKA_SSL_CERTFILE=certs/service.cert
KAFKA_SSL_KEYFILE=certs/service.key

# If using SASL_SSL (User/Password Auth):
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SASL_USERNAME=avnadmin
KAFKA_SASL_PASSWORD=your_aiven_password

# Application Settings
ENVIRONMENT=production
PORT=8000
