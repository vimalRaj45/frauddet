# ================================================================
# MASTER ENVIRONMENT CONFIGURATION
# ================================================================

# ----------------------------------------------------------------
# 1. Neon PostgreSQL Database
# ----------------------------------------------------------------
# Create a free PostgreSQL database at https://console.neon.tech
# Copy your connection URI (ensure sslmode=require)
DATABASE_URL=postgresql://neondb_owner:your_neon_password@ep-cool-sample.us-east-2.aws.neon.tech/neondb?sslmode=require

# ----------------------------------------------------------------
# 2. Aiven Kafka Streaming
# ----------------------------------------------------------------
# Create a free or standard Kafka service at https://console.aiven.io
# Copy the Service URI (host:port)
KAFKA_BOOTSTRAP_SERVERS=kafka-service-org.aivencloud.com:12345
KAFKA_TOPIC=fintech.transactions
KAFKA_CONSUMER_GROUP=fraud-detection-group

# Security Protocol: SSL, SASL_SSL, or PLAINTEXT
KAFKA_SECURITY_PROTOCOL=SSL

# If using SSL Client Certificates (Standard Aiven Kafka):
# Download ca.pem, service.cert, and service.key from Aiven console and place in backend/certs/
KAFKA_SSL_CAFILE=certs/ca.pem
KAFKA_SSL_CERTFILE=certs/service.cert
KAFKA_SSL_KEYFILE=certs/service.key

# If using SASL_SSL (Username/Password authentication):
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SASL_USERNAME=avnadmin
KAFKA_SASL_PASSWORD=your_aiven_password

# ----------------------------------------------------------------
# 3. Frontend Configuration
# ----------------------------------------------------------------
VITE_API_URL=http://localhost:8000
